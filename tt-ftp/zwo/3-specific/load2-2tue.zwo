  <tags/>
  <workout>
    <Warmup Duration="900" PowerLow="0.55" PowerHigh="0.65"/>
    <IntervalsT Repeat="4" OnDuration="300" OffDuration="240" OnPower="1.105" OffPower="0.5"/>

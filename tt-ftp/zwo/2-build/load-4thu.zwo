<workout_file>
  <author>峠TT FTPプランナー</author>
  <name>ビルド期 負荷週 木 閾値 2×20分</name>
  <description>ビルド期（閾値＋VO2強化）</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="900" PowerLow="0.55" PowerHigh="0.65"/>

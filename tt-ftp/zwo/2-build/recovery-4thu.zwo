<workout_file>
  <author>峠TT FTPプランナー</author>
  <name>ビルド期 回復週 木 キーセッション：閾値 2×12分</name>
  <description>ビルド期（閾値＋VO2強化）</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="900" PowerLow="0.55" PowerHigh="0.65"/>
    <IntervalsT Repeat="1" OnDuration="720" OffDuration="360" OnPower="0.975" OffPower="0.55"/>
    <SteadyState Duration="720" Power="0.975"/>
    <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.45"/>
  </workout>
</workout_file>

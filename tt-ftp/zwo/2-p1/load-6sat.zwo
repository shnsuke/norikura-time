    <SteadyState Duration="4800" Power="0.65"/>
    <IntervalsT Repeat="1" OnDuration="1200" OffDuration="600" OnPower="0.805" OffPower="0.6"/>
    <SteadyState Duration="1200" Power="0.805"/>
    <SteadyState Duration="6600" Power="0.65"/>
  </workout>
</workout_file>

<workout_file>
  <author>峠TT FTPプランナー</author>
  <name>P1 冬季ベース 負荷週 火 V2 VO2 4×4分</name>
  <description>P1 冬季ベース（有酸素の土台と VO2max、筋力（山なし））
ローラー。スプリントは入れない（目的は VO2max）</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.65"/>
    <IntervalsT Repeat="3" OnDuration="240" OffDuration="240" OnPower="1.11" OffPower="0.5"/>
    <SteadyState Duration="240" Power="1.11"/>
    <SteadyState Duration="600" Power="0.65"/>
    <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45"/>
  </workout>
</workout_file>

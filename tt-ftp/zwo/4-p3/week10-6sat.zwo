<workout_file>
  <author>峠TT FTPプランナー</author>
  <name>P3 特異 10週目 土 地元峠TT（乗鞍6週前）</name>
  <description>P3 特異（50〜60分のレースシミュレーション、ペースアップ対応（ポラライズド寄り））
合格ライン：FTP 340W前後</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="1200" PowerLow="0.55" PowerHigh="0.65"/>
    <IntervalsT Repeat="2" OnDuration="60" OffDuration="120" OnPower="1" OffPower="0.5"/>
    <SteadyState Duration="60" Power="1"/>
    <FreeRide Duration="2700"/>
    <Cooldown Duration="1800" PowerLow="0.6" PowerHigh="0.5"/>
  </workout>
</workout_file>

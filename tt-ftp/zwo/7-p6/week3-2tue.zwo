<workout_file>
  <author>峠TT FTPプランナー</author>
  <name>P6 テーパー 3週目 火 VO2 3×3分</name>
  <description>P6 テーパー（強度を残して量を落とす）
ローラー。スプリントは入れない（目的は VO2max）</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="900" PowerLow="0.55" PowerHigh="0.65"/>
    <IntervalsT Repeat="2" OnDuration="180" OffDuration="180" OnPower="1.125" OffPower="0.5"/>
    <SteadyState Duration="180" Power="1.125"/>
    <SteadyState Duration="600" Power="0.65"/>
    <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45"/>
  </workout>
</workout_file>

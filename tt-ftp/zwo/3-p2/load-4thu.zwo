<workout_file>
  <author>峠TT FTPプランナー</author>
  <name>P2 ビルド 負荷週 木 閾値 2×20分</name>
  <description>P2 ビルド（閾値とVO2maxの引き上げ、3月から実坂（閾値＋VO2））</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.65"/>
    <IntervalsT Repeat="1" OnDuration="1200" OffDuration="600" OnPower="0.985" OffPower="0.55"/>
    <SteadyState Duration="1200" Power="0.985"/>
    <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45"/>
  </workout>
</workout_file>

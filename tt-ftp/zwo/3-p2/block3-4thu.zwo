<workout_file>
  <author>峠TT FTPプランナー</author>
  <name>P2 ビルド B3負荷週 木 オーバーアンダー 3×12分</name>
  <description>P2 ビルド（閾値とVO2maxの引き上げ、3月から実坂（閾値＋VO2））</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.65"/>
    <IntervalsT Repeat="4" OnDuration="120" OffDuration="60" OnPower="0.95" OffPower="1.08"/>
    <SteadyState Duration="300" Power="0.5"/>
    <IntervalsT Repeat="4" OnDuration="120" OffDuration="60" OnPower="0.95" OffPower="1.08"/>
    <SteadyState Duration="300" Power="0.5"/>
    <IntervalsT Repeat="4" OnDuration="120" OffDuration="60" OnPower="0.95" OffPower="1.08"/>
    <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45"/>
  </workout>
</workout_file>

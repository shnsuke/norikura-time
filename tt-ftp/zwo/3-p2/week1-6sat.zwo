<workout_file>
  <author>峠TT FTPプランナー</author>
  <name>P2 ビルド 1週目 土 ローラー 2×25分（2月中）</name>
  <description>P2 ビルド（閾値とVO2maxの引き上げ、3月から実坂（閾値＋VO2））
2月中は山に行かない。3月から実坂 2×30分</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="900" PowerLow="0.55" PowerHigh="0.65"/>
    <IntervalsT Repeat="1" OnDuration="1500" OffDuration="480" OnPower="0.925" OffPower="0.55"/>
    <SteadyState Duration="1500" Power="0.925"/>
    <SteadyState Duration="1800" Power="0.65"/>
    <Cooldown Duration="420" PowerLow="0.55" PowerHigh="0.45"/>
  </workout>
</workout_file>

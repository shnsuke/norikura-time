<workout_file>
  <author>峠TT FTPプランナー</author>
  <name>P2 ビルド 負荷週1 火 VO2 5×5分</name>
  <description>P2 ビルド（閾値とVO2maxの引き上げ、3月から実坂（閾値＋VO2））</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.65"/>
    <IntervalsT Repeat="4" OnDuration="300" OffDuration="300" OnPower="1.14" OffPower="0.5"/>
    <SteadyState Duration="300" Power="1.14"/>
    <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45"/>
  </workout>
</workout_file>

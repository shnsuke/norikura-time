<workout_file>
  <author>峠TT FTPプランナー</author>
  <name>特異期 負荷週1 火 加速の再現（5分 110% → 10分 90%）×3</name>
  <description>特異期（おきなわの展開を再現する）</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.65"/>
    <IntervalsT Repeat="2" OnDuration="300" OffDuration="600" OnPower="1.1" OffPower="0.9"/>
    <SteadyState Duration="300" Power="1.1"/>
    <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45"/>
  </workout>
</workout_file>

<workout_file>
  <author>峠TT FTPプランナー</author>
  <name>P4 ピーク 2週目 火 VO2 4×5分</name>
  <description>P4 ピーク（強度を残して量を落とす（短い高強度のみ））</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.65"/>
    <IntervalsT Repeat="3" OnDuration="300" OffDuration="300" OnPower="1.1" OffPower="0.5"/>
    <SteadyState Duration="300" Power="1.1"/>
    <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.45"/>
  </workout>
</workout_file>

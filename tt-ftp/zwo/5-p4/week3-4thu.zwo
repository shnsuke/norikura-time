<workout_file>
  <author>峠TT FTPプランナー</author>
  <name>P4 ピーク 3週目 木 閾値 短め 3×8分</name>
  <description>P4 ピーク（強度を残して量を落とす（短い高強度のみ））</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="900" PowerLow="0.55" PowerHigh="0.65"/>
    <IntervalsT Repeat="2" OnDuration="480" OffDuration="240" OnPower="0.975" OffPower="0.55"/>
    <SteadyState Duration="480" Power="0.975"/>
    <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.45"/>
  </workout>
</workout_file>
